# The operation log both items record to. The end-to-end tests set it to a
# file in a temporary directory.
variable "log" {
  default = "./ops.jsonl"
}

# first holds a sensitive secret, which xcl masks in events and state
test "item" "first" {
  log    = variable.log
  value  = "one"
  secret = "hunter2"
}

# second takes first's computed output as its input, so it depends on first:
# it is created after first and destroyed before it
test "item" "second" {
  log   = variable.log
  value = "two"
  input = test.item.first.output
}
